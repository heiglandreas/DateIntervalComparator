{
	"name": "org_heigl/dateintervalcomparator",
	"description": "Compare two DateInterval-Objects with one another",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Andreas Heigl",
			"email": "andreas@heigl.org"
		}
	],
	"autoload": {
		"psr-4": {
			"Org_Heigl\\DateIntervalComparator\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Org_Heigl\\DateIntervalComparatorTest\\": "tests/"
		}
	},
	"require": {
		"php": "^7.1 || ^8.0"
	},
	"scripts": {
		"check": [
			"@cs-check",
			"@test"
		],
		"upload-coverage": [
			"curl -o coveralls -L https://github.com/php-coveralls/php-coveralls/releases/download/v2.0.0/php-coveralls.phar",
			"chmod 755 coveralls",
			"./coveralls -v"
		],
		"cs-install": [
			"cd tools/phpcs",
			"composer install",
			"cd ../.."
		],
		"cs-check": [
			"@cs-install",
			"./tools/phpcs/vendor/bin/phpcs --version && ./tools/phpcs/vendor/bin/phpcs"
		],
		"cs-fix": [
			"@cs-install",
			"./tools/phpcs/vendor/bin/phpcbf"
		],
		"test": "phpunit --colors=always",
		"test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
	}
}
